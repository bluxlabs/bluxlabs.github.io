# Confirmed provider: Gmail SMTP (server-only).
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Google App Password if allowed by the account admin; not the normal login password.
SMTP_PASS=

# Server-only: never use VITE_ for these values.
RESEND_API_KEY=
# A sender address on your verified sending domain.
CONTACT_FROM=
# Optional locally; set to the exact public origin on deployment.
CONTACT_ALLOWED_ORIGIN=
